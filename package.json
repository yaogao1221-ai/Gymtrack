{
  "name": "gymtrack-ai",
  "version": "1.0.0",
  "private": true,
  "description": "GymTrack AI — application personnelle de suivi musculation et cardio (PWA + API + SQLite)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js & vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "build:standalone": "VITE_STANDALONE=1 vite build --config client/vite.config.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "chart.js": "^4.5.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sql.js": "^1.13.0",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
